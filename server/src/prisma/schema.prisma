generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────
// AUTH
// ─────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(ADMIN)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum Role {
  ADMIN
}

// ─────────────────────────────────────────
// PROJECTS
// ─────────────────────────────────────────

model Project {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String
  techStack   String[]
  featured    Boolean  @default(false)
  published   Boolean  @default(false)
  githubUrl   String?
  liveUrl     String?
  imageUrl    String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([featured])
  @@index([published])
}

// ─────────────────────────────────────────
// CONTACT
// ─────────────────────────────────────────

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([read])
  @@index([createdAt])
}

// ─────────────────────────────────────────
// RESUME
// ─────────────────────────────────────────

model ResumeFile {
  id         String   @id @default(cuid())
  filename   String
  url        String
  version    Int      @default(1)
  isActive   Boolean  @default(false)
  uploadedAt DateTime @default(now())

  @@index([isActive])
}

// ─────────────────────────────────────────
// ANALYTICS
// ─────────────────────────────────────────

model PageView {
  id        String   @id @default(cuid())
  path      String
  visitorId String?
  createdAt DateTime @default(now())

  @@index([path])
  @@index([createdAt])
}

// ─────────────────────────────────────────
// DEV LOG
// ─────────────────────────────────────────

model DevLogEntry {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  summary   String
  content   String
  tags      String[]
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published])
  @@index([createdAt])
}
